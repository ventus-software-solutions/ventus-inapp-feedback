{
  "name": "@ventus-software-solutions/feedback-browser",
  "version": "0.1.0-beta.3",
  "description": "Framework-neutral browser capture core for Ventus In-App Feedback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventus-software-solutions/ventus-inapp-feedback.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/ventus-software-solutions/ventus-inapp-feedback#readme",
  "bugs": {
    "url": "https://github.com/ventus-software-solutions/ventus-inapp-feedback/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core/createFeedbackCaptureCore.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "test": "npm run build && node --test ./test/*.test.mjs",
    "typecheck": "tsc --noEmit -p ./tsconfig.build.json && npm run build && tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext ./test/types.test.ts",
    "prepublishOnly": "node ../../scripts/check-release-readiness.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "feedback",
    "bug-reporting",
    "screenshot",
    "diagnostics"
  ]
}
