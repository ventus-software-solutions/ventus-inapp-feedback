VENTUS_API_HOST=0.0.0.0
VENTUS_API_PORT=8080
# Keep false without a reverse proxy. In production use a trusted hop count or
# comma-separated proxy addresses/CIDRs; never use an unrestricted true value.
VENTUS_TRUST_PROXY=false
VENTUS_DATABASE_URL=postgres://ventus:ventus@localhost:5432/ventus_feedback
VENTUS_DATABASE_POOL_SIZE=10
VENTUS_INGESTION_RATE_LIMIT_MAX=60
VENTUS_INGESTION_RATE_LIMIT_WINDOW_MS=60000
VENTUS_AUTO_MIGRATE=true
VENTUS_AUTO_SEED_CONFIGURED_PROJECTS=true
VENTUS_S3_BUCKET=ventus-feedback
VENTUS_S3_ENDPOINT=http://localhost:9000
VENTUS_S3_PUBLIC_ENDPOINT=http://localhost:9000
VENTUS_S3_REGION=us-east-1
VENTUS_S3_ACCESS_KEY_ID=ventus-local
VENTUS_S3_SECRET_ACCESS_KEY=ventus-local-password
VENTUS_S3_FORCE_PATH_STYLE=true
VENTUS_S3_AUTO_CREATE_BUCKET=true
VENTUS_S3_SERVER_SIDE_ENCRYPTION=false
VENTUS_ALLOW_UNSCANNED_ATTACHMENTS=true
VENTUS_ATTACHMENT_MAX_FILE_BYTES=10485760
VENTUS_ATTACHMENT_MAX_SUBMISSION_BYTES=26214400
# Retention is disabled until a positive policy is chosen. The cleanup command
# remains a dry run unless VENTUS_RETENTION_DRY_RUN is explicitly false.
# VENTUS_RETENTION_DAYS=365
VENTUS_RETENTION_PURGE_GRACE_DAYS=7
VENTUS_RETENTION_BATCH_SIZE=100
VENTUS_RETENTION_DRY_RUN=true
VENTUS_LOG_LEVEL=info
VENTUS_PROJECT_KEYS_JSON={"demo-browser-key":{"workspaceId":"ws_demo","projectId":"prj_demo","allowedOrigins":["http://localhost:3000"]}}
VENTUS_SERVICE_TOKENS_JSON={"demo-service-token":{"workspaceId":"ws_demo","actorId":"svc_demo","actorType":"service_account","displayName":"Demo service","scopes":["feedback:read","feedback:triage","feedback:comment","feedback:resolve","feedback:close"]}}
